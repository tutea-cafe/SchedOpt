# Generate a GNU MathProg data file for model/schedule.mod from the event definition and the processed data.
#
#   gawk -f scripts/make_dat.awk config/2026/roles.csv config/2026/slots.csv data/processed/2026.tsv > out/2026.dat
#
# Run scripts/check_processed.awk first; this script assumes valid input.

function q(s) { gsub(/'/, "''", s); return "'" s "'" }   # quoted MathProg symbol

BEGIN { FS = "\t" }

FILENAME == ARGV[1] {                    # roles.csv: role,label,skill,need
  if (FNR > 1) {
    split($0, a, ",")
    roles[++nr] = a[1]; need_role[a[1]] = a[4]
    if (a[3] == 1) skillrole[a[1]]
  }
  next
}
FILENAME == ARGV[2] {                    # slots.csv: date,slot,kind,start,end,label
  if (FNR > 1) {
    split($0, a, ",")
    ns++; sd[ns] = a[1]; ss[ns] = a[2]; kind[ns] = a[3]; pos[ns] = ++npos[a[1]]
  }
  next
}
FNR == 1 { for (i = 6; i <= NF; i++) date[i] = $i; next }
{                                        # processed data
  nm++; id[nm] = $1; nam[nm] = $2; grd[nm] = $3
  n = split($4, p, " "); for (k = 1; k <= n; k++) rank[nm, k] = p[k]; npref[nm] = n
  n = split($5, sk, " "); for (k = 1; k <= n; k++) { split(sk[k], kv, "="); skill[nm, kv[1]] = kv[2] }
  for (i = 6; i <= NF; i++) { n = split($i, v, " "); for (k = 1; k <= n; k++) avail[++na] = $1 " " q(date[i]) " " v[k] }
}

END {
  print "/* generated by scripts/make_dat.awk */"
  print "data;\n"

  printf "set M :=";             for (i = 1; i <= nm; i++) printf "\n  %s", id[i];               print ";\n"
  printf "param name :=";        for (i = 1; i <= nm; i++) printf "\n  %s %s", id[i], q(nam[i]); print ";\n"
  printf "param grade :=";       for (i = 1; i <= nm; i++) printf "\n  %s %s", id[i], grd[i];    print ";\n"

  printf "set R :=";             for (k = 1; k <= nr; k++) printf " %s", roles[k];               print ";"
  printf "set RS :=";            for (k = 1; k <= nr; k++) if (roles[k] in skillrole) printf " %s", roles[k]; print ";"
  printf "param need_role :=";   for (k = 1; k <= nr; k++) printf " %s %d", roles[k], need_role[roles[k]]; print ";\n"

  printf "set S :=";             for (i = 1; i <= ns; i++) printf "\n  (%s, %s)", q(sd[i]), ss[i]; print ";"
  printf "set SV :=";            for (i = 1; i <= ns; i++) if (kind[i] == "service") printf "\n  (%s, %s)", q(sd[i]), ss[i]; print ";"
  printf "param pos :=";         for (i = 1; i <= ns; i++) printf "\n  %s %s %d", q(sd[i]), ss[i], pos[i]; print ";\n"

  printf "set A :=";             for (k = 1; k <= na; k++) printf "\n  (%s)", gensub(/ /, ", ", "g", avail[k]); print ";\n"

  printf "param pref_rank :=";
  for (i = 1; i <= nm; i++) for (k = 1; k <= npref[i]; k++) printf "\n  %s %s %d", id[i], rank[i, k], k
  print ";\n"

  printf "param skill :="
  for (i = 1; i <= nm; i++) for (k = 1; k <= nr; k++) if ((i, roles[k]) in skill && roles[k] in skillrole)
    printf "\n  %s %s %d", id[i], roles[k], skill[i, roles[k]]
  print ";\n"

  print "end;"
}
